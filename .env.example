FIRST_LIGHT_DATABASE_URL=sqlite:///./first_light.db
FIRST_LIGHT_HMAC_SECRET_KEY=change_me_to_a_random_64_char_hex_string
FIRST_LIGHT_RATE_LIMIT_PER_MINUTE=60
FIRST_LIGHT_DEFAULT_MISSION_PROFILE=earth_observation

# Read directly by the Anthropic SDK (not FIRST_LIGHT_-prefixed) for the Mission Planner
# Agent's real Claude API call in producer/llm_planner.py. Without it, the Planner Agent
# falls back to a deterministic preset and says so honestly in its reasoning summary —
# it never fabricates an LLM response.
ANTHROPIC_API_KEY=
